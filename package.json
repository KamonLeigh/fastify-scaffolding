{
  "name": "fastify-app",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "tap \"test/**/*.test.js\"",
    "start": "fastify start -l info --options app.js",
    "dev": "npm run start -- --watch --pretty-logs -debug",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "mongo:start": "docker run -d -p 27017:27017 --rm --name fastify-mongo mongo:7",
    "mongo:stop": "docker container stop fastify-mongo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^5.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^7.0.0",
    "@fastify/mongodb": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@sentry/node": "^10.58.0",
    "fastify": "^5.8.5",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^4.0.0",
    "inngest": "^4.11.0"
  },
  "devDependencies": {
    "standard": "^17.1.2",
    "tap": "^21.7.4"
  }
}
